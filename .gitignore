# =============================================================================
# Study Bloom — .gitignore
# O que NÃO sobe para o GitHub (arquivos gerados, secretos ou locais)
# =============================================================================

# --- Dependências (baixadas com npm / cargo) ---
node_modules/
**/node_modules/

# --- Builds (gerados ao compilar) ---
dist/
build/
out/
app/dist/
app/src-tauri/target/
**/target/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variáveis de ambiente / segredos ---
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# --- Chaves de assinatura do updater Tauri (NUNCA subir a privada) ---
*.key
.tauri/
app/src-tauri/*.key
!*.key.pub
updater-private.key
TAURI_SIGNING_PRIVATE_KEY*

# --- Sistema operacional ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editores / IDEs ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# --- Rust / Tauri ---
**/*.rs.bk
Cargo.lock.bak
*.pdb

# --- Testes / cobertura ---
coverage/
.nyc_output/
*.lcov

# --- Cache de ferramentas ---
.cache/
.parcel-cache/
.turbo/
.eslintcache
*.tsbuildinfo
.vite/

# --- Pacotes / instaladores gerados ---
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.sig
dist-installers/
!app/src-tauri/icons/**

# --- Temporários ---
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig

# --- Dados locais do app (banco SQLite da usuária) ---
*.db
*.db-journal
*.db-wal
*.db-shm
data/local/
app/data/
